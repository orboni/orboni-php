{
    "name": "orboni/orboni-php",
    "description": "Orboni's API for PHP: crypto payments (USDT, USDC, BTC and more) paid straight to your own wallets.",
    "type": "library",
    "keywords": [
        "orboni",
        "crypto",
        "payments",
        "usdt",
        "usdc",
        "bitcoin",
        "checkout",
        "payment-gateway",
        "webhooks"
    ],
    "homepage": "https://orboni.com/docs/libraries",
    "license": "MIT",
    "authors": [
        {
            "name": "Orboni",
            "email": "support@orboni.com",
            "homepage": "https://orboni.com"
        }
    ],
    "support": {
        "email": "support@orboni.com",
        "issues": "https://github.com/orboni/orboni-php/issues",
        "source": "https://github.com/orboni/orboni-php",
        "docs": "https://orboni.com/docs/libraries"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Orboni\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orboni\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
